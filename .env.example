# Copy to .env.local (Next.js) and/or .env (pipeline) and fill in.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.

# --- Site ---
# Public base URL, used for canonical/OG tags and links in generated social posts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: if set, /api/pipeline/status requires this as a Bearer token.
PIPELINE_STATUS_TOKEN=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model used by the writer/editor agents.
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Reddit (Phase 2) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=unsocialengineering/0.1

# --- Twitter/X (deferred) ---
TWITTER_BEARER_TOKEN=

# --- Pipeline behaviour ---
# Legacy compatibility only: the editor always holds articles for review.
# AUTO_PUBLISH does not authorize publication.
AUTO_PUBLISH=false
HUMAN_REVIEW=true
CONFIDENCE_THRESHOLD=70
MAX_ARTICLES_PER_RUN=3

# --- Reviewed destination adapter (set in the calling process, not a public bundle) ---
# publisher.py deliberately does not load .env files. Use a restricted signed-in
# identity's access token, never the broad SUPABASE_SERVICE_ROLE_KEY.
UE_SUPABASE_URL=
UE_SUPABASE_PUBLIC_KEY=
UE_EDITORIAL_ACCESS_TOKEN=
